# Copy to secrets.toml for LOCAL runs, or paste the contents into
# Streamlit Cloud:  App -> Settings -> Secrets
#
# secrets.toml is gitignored. Never commit a real key.
# If this is absent, the app runs in offline mock mode automatically.

GOOGLE_API_KEY = "paste-your-key-from-aistudio.google.com/apikey"

# Set to "1" to force offline mock mode even when a key is present.
MOCK_MODE = "0"
