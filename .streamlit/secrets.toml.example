# Copy to secrets.toml for LOCAL runs, or paste into
# Streamlit Cloud:  App menu -> Settings -> Secrets
#
# secrets.toml is gitignored. Never commit a real key.
# With no key at all, the app runs in offline mock mode automatically.

# --- Pick ONE provider ---------------------------------------------------
# Checked in this order: OpenRouter, then Gemini, then mock.

# OpenRouter (recommended) -- https://openrouter.ai/keys
# Many free models, and the app walks a fallback chain when one is throttled.
OPENROUTER_API_KEY = "sk-or-v1-..."

# Google Gemini -- https://aistudio.google.com/apikey
# GOOGLE_API_KEY = "AIza..."

# --- Optional ------------------------------------------------------------
# Force offline mock mode even when a key is present. This is the on-stage
# fallback: set to "1" and everything works with no network.
MOCK_MODE = "0"

# Pin a single OpenRouter model, disabling the fallback chain.
# Leave unset unless you have a reason -- the chain is what survives throttling.
# OPENROUTER_MODEL = "inclusionai/ling-3.0-flash:free"
