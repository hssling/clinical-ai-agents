# Copy to secrets.toml for LOCAL runs, or paste into
# Streamlit Cloud:  App menu -> Settings -> Secrets
#
# secrets.toml is gitignored. Never commit a real key.
# With no key at all, the app runs in offline mock mode automatically.

# --- Set ONE key. Checked in this order --------------------------------
#     OPENAI_API_KEY  ->  OPENROUTER_API_KEY  ->  GOOGLE_API_KEY  ->  mock
#
# The order is deliberate: dropping in a paid OpenAI key on the day takes
# over automatically and removes free-tier throttling from the live demo.

# OpenAI -- https://platform.openai.com/api-keys
# Most reliable, but the account MUST have billing set up. A key with no
# credit lists models happily and then returns 429 on every completion.
# OPENAI_API_KEY = "sk-proj-..."

# OpenRouter -- https://openrouter.ai/keys
# Free models. The app walks a fallback chain when one is throttled.
OPENROUTER_API_KEY = "sk-or-v1-..."

# Google Gemini -- https://aistudio.google.com/apikey
# GOOGLE_API_KEY = "AIza..."

# --- Optional ----------------------------------------------------------
# Force offline mock mode even when a key is present. This is the on-stage
# fallback: set to "1" and everything works with no network.
MOCK_MODE = "0"

# Pin a single model, disabling that provider's fallback chain.
# Leave unset unless you have a reason -- the chain is what survives failures.
# OPENAI_MODEL = "gpt-4.1-mini"
# OPENROUTER_MODEL = "inclusionai/ling-3.0-flash:free"
