# Copy to .env and fill in, or set these in your shell.
# NEVER commit the real .env file.

# Free key from https://aistudio.google.com/apikey
# If this is absent, the app automatically runs in offline mock mode.
GOOGLE_API_KEY=

# Force offline mock mode even when a key is present.
# This is the on-stage fallback: set to 1 and everything works with no internet.
MOCK_MODE=0

# Optional: override the model.
AGENT_MODEL=gemini-2.0-flash
