# Copy to .env and fill in, or set these in your shell.
# NEVER commit the real .env file.
#
# Set ONE key. Providers are checked in this order:
#     OPENAI_API_KEY -> OPENROUTER_API_KEY -> GOOGLE_API_KEY -> mock
# With no key at all, the app runs in offline mock mode automatically.

# OpenAI -- https://platform.openai.com/api-keys
# Most reliable, but the account MUST have billing set up. A key with no
# credit lists models happily and then returns 429 on every completion.
OPENAI_API_KEY=

# OpenRouter -- https://openrouter.ai/keys
# Free models; the app walks a fallback chain when one is throttled.
OPENROUTER_API_KEY=

# Google Gemini -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Force offline mock mode even when a key is present.
# This is the on-stage fallback: set to 1 and everything works with no internet.
MOCK_MODE=0

# Optional: pin one model, disabling that provider's fallback chain.
# OPENAI_MODEL=gpt-4.1-mini
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Optional: override the Gemini model.
AGENT_MODEL=gemini-2.0-flash

# Verify whatever you set:   python agents/provider.py
