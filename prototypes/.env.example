# Copy to .env and fill in, or set these in your shell.
# NEVER commit the real .env file.
#
# Providers are checked in this order: OpenRouter, then Gemini, then mock.
# With no key at all, the app runs in offline mock mode automatically.

# OpenRouter (recommended) -- https://openrouter.ai/keys
# Many free models; the app walks a fallback chain when one is throttled.
OPENROUTER_API_KEY=

# Google Gemini -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Force offline mock mode even when a key is present.
# This is the on-stage fallback: set to 1 and everything works with no internet.
MOCK_MODE=0

# Optional: pin one OpenRouter model, disabling the fallback chain.
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Optional: override the Gemini model.
AGENT_MODEL=gemini-2.0-flash
